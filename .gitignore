# ──────────────────────────────────────────────
# Environment & Secrets
# ──────────────────────────────────────────────
.env
.env.*
!.env.example

# ──────────────────────────────────────────────
# Server-side config that may contain credentials
# ──────────────────────────────────────────────
config.php
db_config.php
wp-config.php
*.sql
*.sqlite
*.db

# ── Allow tracked server files (no secrets inside) ──
!api/config.php
!database/schema.sql

