# ──────────────────────────────────────────────────────────────
# Server-side environment variables (Hostinger / your server)
# ──────────────────────────────────────────────────────────────
# Copy this file to .env on your server and fill in the real values.
# NEVER commit the actual .env file to version control.
# ──────────────────────────────────────────────────────────────

# Database
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=localhost

# Application
APP_ENV=production
APP_DEBUG=false

# Auth API (used by auth.js on the client side)
AUTH_API_BASE=https://trading.dsitservicesja.com/api/auth

# JWT / Session secret (used server-side for token signing)
JWT_SECRET=generate_a_random_64_char_string_here
